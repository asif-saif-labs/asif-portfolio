---
// Press ":" anywhere (outside a text field) for a tiny shell.
---
<dialog class="palette" aria-label="Command palette">
  <form method="dialog">
    <label for="palette-input" class="green">:</label>
    <input id="palette-input" autocomplete="off" spellcheck="false" placeholder="type help, then Enter" />
  </form>
  <pre class="log" aria-live="polite"></pre>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.palette")!;
  const input = dialog.querySelector<HTMLInputElement>("input")!;
  const log = dialog.querySelector<HTMLPreElement>(".log")!;

  const pages: Record<string, string> = { "~": "/", home: "/", blog: "/blog/", projects: "/projects/", about: "/about/", rss: "/rss.xml" };

  const help = [
    "help              this list",
    "ls                list pages",
    "cd <page>         go to a page (home, blog, projects, about)",
    "theme light|dark  switch theme",
    "whoami            who is this",
    "sudo hire-me      ;)",
    "exit              close (or Esc)",
  ].join("\n");

  function setTheme(t: string) {
    document.documentElement.dataset.theme = t;
    try { localStorage.setItem("theme", t); } catch (e) {}
  }

  function run(line: string): string {
    const [cmd, ...args] = line.trim().split(/\s+/);
    switch (cmd) {
      case "": return "";
      case "help": return help;
      case "ls": return Object.keys(pages).filter((p) => p !== "~").join("  ");
      case "cd": {
        const target = pages[(args[0] || "~").replace(/^\.?\/|\/$/g, "") || "~"];
        if (!target) return `cd: no such page: ${args[0]}`;
        window.location.href = target;
        return "";
      }
      case "theme":
        if (args[0] !== "light" && args[0] !== "dark") return "usage: theme light|dark";
        setTheme(args[0]);
        return `theme set to ${args[0]}`;
      case "whoami": return document.querySelector("meta[name=description]")?.getAttribute("content") || "asif";
      case "sudo":
        if (args.join(" ") === "hire-me") { window.location.href = "/about/#contact"; return "permission granted. redirecting…"; }
        return "asif is not in the sudoers file. This incident will be reported.";
      case "exit": dialog.close(); return "";
      case "rm": return "nice try.";
      default: return `bash: ${cmd}: command not found (try help)`;
    }
  }

  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    const typing = t.closest("input, textarea, [contenteditable]");
    if (e.key === ":" && !typing && !dialog.open) {
      e.preventDefault();
      log.textContent = "type help for commands";
      dialog.showModal();
      input.value = "";
      input.focus();
    }
  });

  dialog.querySelector("form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    const out = run(input.value);
    log.textContent = `$ ${input.value}\n${out}`;
    input.value = "";
  });

  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
</script>
