---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import avatar from "../assets/asif-avatar.jpg";
import PostCard from "../components/PostCard.astro";
import { experience, profile, stackHighlights, stats } from "../data/profile";
import { getPosts } from "../lib";

const posts = (await getPosts()).slice(0, 6);
const roleSummary = experience.map((r) => ({ ...r, summary: r.highlights.slice(0, 2).join(" ") }));
---
<Base>
  <div class="hero">
    <div>
      <span class="label">{profile.role} · {profile.location}</span>
      <h1>{profile.tagline}</h1>
      <p>{profile.summary}</p>
      <div class="links">
        <a class="btn primary" href={profile.links.linkedin}>LinkedIn</a>
        <a class="btn" href={profile.links.github}>GitHub</a>
        <a class="btn" href="/blog/">Read the blog</a>
      </div>
    </div>
    <aside class="spec" aria-label="Summary">
      <div class="who">
        <Image src={avatar} alt={`Photo of ${profile.name}`} width={160} height={160} loading="eager" />
        <div>
          <strong>{profile.name}</strong>
          <span class="label">Spec sheet</span>
        </div>
      </div>
      <dl class="num">
        <dt>role</dt><dd>{profile.role}</dd>
        <dt>location</dt><dd>{profile.location}</dd>
        {stats.slice(0, 3).map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
        <dt>contact</dt><dd><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></dd>
      </dl>
    </aside>
  </div>

  <section>
    <span class="label">Career</span>
    <h2>Experience</h2>
    <div class="timeline">
      {roleSummary.map((r) => (
        <div class="node">
          <span class="when">{r.years}</span>
          <h3>{r.title} · {r.org}</h3>
          <p>{r.summary}</p>
        </div>
      ))}
    </div>
    <p style="margin:14px 0 0"><a href="/about/">Full experience and education →</a></p>
  </section>

  <section>
    <span class="label">Toolchain</span>
    <h2>Stack</h2>
    <div class="stack">{stackHighlights.map((s) => <span>{s}</span>)}</div>
  </section>

  <section>
    <span class="label">Notes</span>
    <h2>Latest writing</h2>
    {posts.length === 0 ? (
      <p class="muted">First post coming soon.</p>
    ) : (
      <div class="cards">{posts.map((p) => <PostCard post={p} />)}</div>
    )}
    <p style="margin:14px 0 0"><a href="/blog/">All posts →</a></p>
  </section>
</Base>
