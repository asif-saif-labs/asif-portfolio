---
import Base from "../layouts/Base.astro";
import Prompt from "../components/Prompt.astro";
import { education, experience, profile, skills, stats } from "../data/profile";
---
<Base title="About" description={`About ${profile.name}: ${profile.role}, ${profile.location}`} path="~/about">
  <Prompt as="h1" path="~" cmd="cat about.md" />
  <div class="out">
    {profile.bio.map((p) => <p style="margin:0 0 10px">{p}</p>)}
  </div>

  <Prompt as="h2" path="~" cmd="cat /proc/career" />
  <div class="out scroll">
    <table class="tbl">
      <tbody>
        {stats.map(([k, v]) => (
          <tr><td class="muted nowrap">{k}</td><td class="amber">{v}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <Prompt as="h2" path="~/career" cmd="git log --graph --format=role" />
  <div class="out">
    {experience.map((r, i) => (
      <div style="margin:0 0 14px">
        <div>
          <span class="red">*</span> <span class="amber">{r.years}</span>{" "}
          <span class="green">{r.title}</span> <span class="muted">@</span> {r.org}
        </div>
        <ul style="margin:4px 0 0;padding-left:0;list-style:none">
          {r.highlights.map((h) => (
            <li style="display:flex;gap:8px">
              <span class="muted" aria-hidden="true">{i < experience.length - 1 ? "|" : " "}</span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <Prompt as="h2" path="~/education" cmd="ls -l" />
  <div class="out">
    {education.map((e) => (
      <div style="margin:0 0 10px">
        <span class="amber">{e.years}</span> <span class="green">{e.title}</span>{" "}
        <span class="muted">@</span> {e.org}
        {e.note && <div class="muted" style="font-size:13px">{e.note}</div>}
      </div>
    ))}
  </div>

  <Prompt as="h2" path="~/skills" cmd="terraform state list" />
  <div class="out">
    {Object.entries(skills).map(([group, items]) => (
      <div style="margin:0 0 6px">
        {items.map((s, i) => (
          <span style="white-space:nowrap">
            <span class="muted">module.{group}.</span><span class="cyan">{s}</span>{i < items.length - 1 ? "  " : ""}
          </span>
        ))}
      </div>
    ))}
  </div>

  <Prompt as="h2" path="~" cmd="curl -s asif/contact" />
  <div class="out" id="contact">
    <pre style="margin:0;white-space:pre-wrap">{`{
  "email":    "`}<a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>{`",
  "github":   "`}<a href={profile.links.github}>{profile.links.github}</a>{`",
  "linkedin": "`}<a href={profile.links.linkedin}>{profile.links.linkedin}</a>{`"
}`}</pre>
  </div>
</Base>
