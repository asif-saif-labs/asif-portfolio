---
import Base from "../layouts/Base.astro";
import { education, experience, profile, skills, stats } from "../data/profile";
---
<Base title="About" description={`About ${profile.name}: ${profile.role}, ${profile.location}`}>
  <div class="hero">
    <div class="bio">
      <span class="label">About</span>
      <h1>{profile.name}</h1>
      {profile.bio.map((p) => <p>{p}</p>)}
    </div>
    <aside class="spec" aria-label="Career summary">
      <div class="h label">By the numbers</div>
      <dl class="num">{stats.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
    </aside>
  </div>

  <section>
    <span class="label">Career</span>
    <h2>Experience</h2>
    <div class="timeline">
      {experience.map((r) => (
        <div class="node">
          <span class="when">{r.years}</span>
          <h3>{r.title} · {r.org}</h3>
          <ul>{r.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section>
    <span class="label">Education</span>
    <h2>Education</h2>
    <div class="timeline">
      {education.map((e) => (
        <div class="node">
          <span class="when">{e.years}</span>
          <h3>{e.title}</h3>
          <p>{e.org}</p>
          {e.note && <p>{e.note}</p>}
        </div>
      ))}
    </div>
  </section>

  <section>
    <span class="label">Toolchain</span>
    <h2>Stack</h2>
    <div class="stack-groups">
      {Object.entries(skills).map(([group, items]) => (
        <div class="g">
          <span class="label" style="padding-top:4px">{group}</span>
          <div class="stack">{items.map((s) => <span>{s}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section id="contact">
    <span class="label">Contact</span>
    <h2>Get in touch</h2>
    <div class="spec" style="max-width:560px">
      <dl>
        <dt>email</dt><dd><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></dd>
        <dt>linkedin</dt><dd><a href={profile.links.linkedin}>{profile.links.linkedin.replace("https://www.", "")}</a></dd>
        <dt>github</dt><dd><a href={profile.links.github}>{profile.links.github.replace("https://", "")}</a></dd>
      </dl>
    </div>
  </section>

  <section>
    <span class="label">This site</span>
    <h2>How it's built</h2>
    <p class="muted" style="margin:0;max-width:68ch">
      Static HTML from Astro, served from a private S3 bucket through CloudFront. The infrastructure is
      Terraform, and every merge to main deploys from GitHub Actions with keyless OIDC.
      <a href="https://github.com/asif-saif-labs/asif-portfolio">Source on GitHub →</a>
    </p>
  </section>
</Base>
