---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Writing" description="Notes on DevOps, cloud infrastructure, Terraform and CI/CD.">
  <section>
    <span class="label">Notes · {posts.length} posts</span>
    <h1 class="section-title" style="font-size:30px">Writing</h1>
    <p class="muted" style="margin:0 0 22px;max-width:62ch">Problems I've hit running cloud infrastructure, and what fixed them. RSS: <a href="/rss.xml">/rss.xml</a></p>
    <div class="cards">{posts.map((p) => <PostCard post={p} showDescription />)}</div>
  </section>
  {tags.length > 0 && (
    <section>
      <span class="label">Index</span>
      <h2>Tags</h2>
      <div class="stack">{tags.map((t) => <a href={`/blog/tags/${t}/`}><span>#{t}</span></a>)}</div>
    </section>
  )}
</Base>
