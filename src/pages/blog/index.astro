---
import Base from "../../layouts/Base.astro";
import Prompt from "../../components/Prompt.astro";
import { getPosts, lsDate, readMinutes } from "../../lib";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="Weekly notes on DevOps, cloud and infrastructure." path="~/blog">
  <Prompt as="h1" path="~/blog" cmd="ls -lt" />
  <div class="out scroll">
    <p class="muted" style="margin:0 0 6px">total {posts.length}</p>
    <table class="tbl">
      <tbody>
        {posts.map((p) => (
          <tr>
            <td class="muted nowrap">{lsDate(p.data.date)}</td>
            <td class="muted nowrap">{readMinutes(p.body)}m</td>
            <td>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              {p.data.draft && <span class="pill amber">draft</span>}
              <div class="muted" style="font-size:13px">{p.data.description}</div>
              <div>{p.data.tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>--tag={t}</a>)}</div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {tags.length > 0 && (
    <>
      <Prompt path="~/blog" cmd="ls tags/" />
      <div class="out">{tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>{t}/</a>)}</div>
    </>
  )}
</Base>
