---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, isoDate, lsDate, readMinutes, type Post } from "../../lib";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article class="article">
    <header>
      <a class="label" href="/blog/">← Writing</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(post.data.date)}>{lsDate(post.data.date)}</time> · {readMinutes(post.body)} min read
      </p>
      <div class="tags">{post.data.tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>#{t}</a>)}</div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <nav class="post-nav" aria-label="More posts">
      <span>{newer && <a href={`/blog/${newer.id}/`}>← {newer.data.title}</a>}</span>
      <span>{older && <a href={`/blog/${older.id}/`}>{older.data.title} →</a>}</span>
    </nav>
  </article>
</Base>
