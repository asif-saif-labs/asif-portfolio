---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Prompt from "../../components/Prompt.astro";
import { getPosts, isoDate, readMinutes, type Post } from "../../lib";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} path={`~/blog/${post.id}.md`}>
  <Prompt path="~/blog" cmd={`cat ${post.id}.md`} />
  <article class="post">
    <h1>{post.data.title}</h1>
    <p class="muted" style="margin:0 0 4px;font-size:13px">
      <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time> · {readMinutes(post.body)} min read
    </p>
    <p style="margin:0 0 24px">{post.data.tags.map((t) => <a class="tag" href={`/blog/tags/${t}/`}>--tag={t}</a>)}</p>
    <Content />
  </article>
  <hr style="border:0;border-top:1px dashed var(--border);margin:32px 0 16px" />
  <nav aria-label="More posts" style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:14px">
    <span>{newer && <a href={`/blog/${newer.id}/`}>← {newer.data.title}</a>}</span>
    <span>{older && <a href={`/blog/${older.id}/`}>{older.data.title} →</a>}</span>
  </nav>
</Base>
