---
import Base from "../../../layouts/Base.astro";
import Prompt from "../../../components/Prompt.astro";
import { getPosts, lsDate, type Post } from "../../../lib";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}

interface Props {
  posts: Post[];
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`} path={`~/blog/tags/${tag}`}>
  <Prompt as="h1" path="~/blog" cmd={`grep -l "tags:.*${tag}" *.md`} />
  <div class="out scroll">
    <table class="tbl">
      <tbody>
        {posts.map((p) => (
          <tr>
            <td class="muted nowrap">{lsDate(p.data.date)}</td>
            <td><a href={`/blog/${p.id}/`}>{p.data.title}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p style="margin:12px 0 0"><a href="/blog/">← all posts</a></p>
  </div>
</Base>
