---
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPosts, type Post } from "../../../lib";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}

interface Props {
  posts: Post[];
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <section>
    <span class="label">Tag · {posts.length} {posts.length === 1 ? "post" : "posts"}</span>
    <h1 class="section-title" style="font-size:30px">#{tag}</h1>
    <div class="cards">{posts.map((p) => <PostCard post={p} showDescription />)}</div>
    <p style="margin:18px 0 0"><a href="/blog/">← All posts</a></p>
  </section>
</Base>
