---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist.">
  <section style="padding-block:60px">
    <span class="label">Error 404</span>
    <h1 class="section-title" style="font-size:34px">This page doesn't exist</h1>
    <p class="muted" style="max-width:56ch">The link may be old, or the page has moved. Try one of these instead:</p>
    <div class="links" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:14px">
      <a class="btn primary" href="/">Home</a>
      <a class="btn" href="/blog/">Writing</a>
      <a class="btn" href="/about/">About</a>
    </div>
  </section>
</Base>
